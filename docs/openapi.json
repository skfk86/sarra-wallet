{
  "openapi": "3.1.0",
  "info": {
    "title": "Sarra Pay API",
    "version": "1.0.0",
    "description": "Non-custodial USDT/USDC payment gateway. Customers pay directly to the merchant wallet; Sarra detects the on-chain transfer and notifies your server. Docs: https://docs.sarrapay.com/ Rate limits: 120 req/min per IP, 300 invoices/hour per account; 20 invalid keys from one IP block it for 10 minutes. Test (sk_test_) invoices are permanently deleted 3 minutes after reaching a final state."
  },
  "servers": [
    {
      "url": "https://api.sarrapay.com"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "sk_live_… for real invoices, sk_test_… for sandbox."
      }
    },
    "schemas": {
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^inv_[0-9a-f]{20}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "expired",
              "cancelled"
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "bsc",
              "tron",
              "polygon",
              "eth"
            ]
          },
          "network_name": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USDT",
              "USDC"
            ]
          },
          "amount": {
            "type": "string",
            "example": "10"
          },
          "pay_amount": {
            "type": "string",
            "description": "Exact amount the customer must send (amount + unique tail < 0.01).",
            "example": "10.004321"
          },
          "address": {
            "type": "string",
            "description": "Merchant receiving address."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "order_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "success_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "fee": {
            "type": "string",
            "description": "Fee deducted from your prepaid credit when paid."
          },
          "tx": {
            "type": [
              "string",
              "null"
            ]
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "pay_url": {
            "type": "string",
            "format": "uri"
          },
          "test": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "payment"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "INSUFFICIENT_CREDIT"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CreateInvoice": {
        "type": "object",
        "required": [
          "amount",
          "network"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^\\d{1,7}(\\.\\d{1,2})?$",
            "description": "1 to 100000, max 2 decimals."
          },
          "network": {
            "type": "string",
            "enum": [
              "bsc",
              "tron",
              "polygon",
              "eth"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USDT",
              "USDC"
            ],
            "default": "USDT",
            "description": "USDC on bsc, polygon and eth only."
          },
          "order_id": {
            "type": "string",
            "pattern": "^[\\w.:\\-]{1,64}$",
            "description": "Idempotency: same order_id with the same amount/network/currency returns the same invoice while pending or paid; different values return 409 ORDER_ID_CONFLICT."
          },
          "description": {
            "type": "string",
            "maxLength": 140
          },
          "expires_min": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120,
            "default": 30
          },
          "success_url": {
            "type": "string",
            "format": "uri",
            "description": "https only. sarra_invoice and sarra_status are appended."
          },
          "metadata": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "invoice.paid",
              "invoice.expired",
              "invoice.cancelled",
              "test"
            ]
          },
          "invoice": {
            "$ref": "#/components/schemas/Invoice"
          }
        },
        "description": "POSTed to your webhook URL. Header X-Sarra-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + '.' + raw_body)>. Reply 2xx within 8s; retried 6 times over ~16h."
      }
    }
  },
  "paths": {
    "/v1/invoices": {
      "post": {
        "summary": "Create an invoice",
        "operationId": "createInvoice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoice"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoice": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "INSUFFICIENT_CREDIT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (see Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE (body > 16 KB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "ORDER_ID_CONFLICT or TRY_AGAIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "MERCHANT_DISABLED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List invoices (newest first)",
        "operationId": "listInvoices",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "paid",
                "expired",
                "cancelled"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Cursor: id of the last invoice of the previous page.",
            "schema": {
              "type": "string",
              "pattern": "^inv_[0-9a-f]{20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoices": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invoice"
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "BAD_STATUS_FILTER or BAD_CURSOR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/invoices/{id}": {
      "get": {
        "summary": "Get an invoice",
        "operationId": "getInvoice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^inv_[0-9a-f]{20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoice": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/invoices/{id}/cancel": {
      "post": {
        "summary": "Cancel a pending invoice",
        "operationId": "cancelInvoice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^inv_[0-9a-f]{20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoice": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "NOT_PENDING",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/invoices/{id}/simulate": {
      "post": {
        "summary": "Simulate payment or expiry (sk_test_ only)",
        "operationId": "simulateInvoice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^inv_[0-9a-f]{20}$"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "paid",
                      "expired"
                    ],
                    "default": "paid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoice": {
                      "$ref": "#/components/schemas/Invoice"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "TEST_KEY_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "NOT_PENDING",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/balance": {
      "get": {
        "summary": "Prepaid fee credit",
        "operationId": "getBalance",
        "responses": {
          "200": {
            "description": "Balance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "test": {
                      "type": "boolean"
                    },
                    "credit": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "fee_pct": {
                      "type": "number"
                    },
                    "fee_min": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "invoiceEvent": {
      "post": {
        "summary": "Invoice reached a final state",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledge"
          }
        }
      }
    }
  }
}